PORT=3000
GEMINI_API_KEY=your_google_ai_studio_gemini_api_key
GITHUB_TOKEN=your_github_personal_access_token_with_repo_scope
WEBHOOK_SECRET=your_github_webhook_secret_string

# Optional
GEMINI_MODEL=gemini-2.5-flash
# When true: analyze and log the patch, but do NOT open a PR
DRY_RUN=true
# Sandbox: clone at the failing commit, apply the patch, run SANDBOX_COMMAND before opening the PR
SANDBOX_ENABLED=false
SANDBOX_COMMAND=npm ci && npm test
SANDBOX_TIMEOUT_MS=600000
# Gemini retries (with sandbox output as feedback) before giving up
MAX_FIX_ATTEMPTS=2
# Comma-separated "owner/repo" allowlist. Empty = allow all repos that send webhooks
ALLOWED_REPOS=
